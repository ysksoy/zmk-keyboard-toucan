#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC  0
#define NAV  1
#define SYM  2
#define ADJ  3
#define WIN  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rightclick {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        leftclick {
            bindings = <&mkp LCLK>;
            key-positions = <19 18>;
        };

        // Mac-specific combos

        returninbrows_mac {
            bindings = <&kp LG(LEFT_BRACKET)>;
            key-positions = <14 15>;
            layers = <0>;
        };

        goahead_mac {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <17 16>;
            layers = <0>;
        };

        screenshot_mac {
            bindings = <&kp LG(LS(NUMBER_4))>;
            key-positions = <0 1>;
            layers = <0>;
        };

        reloadingbrows_mac {
            bindings = <&kp LG(R)>;
            key-positions = <15 16>;
            layers = <0>;
        };

        controlcenter_mac {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <26 27>;
            layers = <0>;
        };

        // Windows-specific combos

        returninbrows_win {
            bindings = <&kp LA(LEFT_ARROW)>;
            key-positions = <14 15>;
            layers = <1>;
        };

        goahead_win {
            bindings = <&kp LA(RIGHT_ARROW)>;
            key-positions = <17 16>;
            layers = <1>;
        };

        screenshot_win {
            bindings = <&kp LG(LS(S))>;
            key-positions = <0 1>;
            layers = <1>;
        };

        reloadingbrows_win {
            bindings = <&kp F5>;
            key-positions = <15 16>;
            layers = <1>;
        };

        taskview_win {
            bindings = <&kp LG(TAB)>;
            key-positions = <26 27>;
            layers = <1>;
        };

        // Common combos (work on both layers)

        minus {
            bindings = <&kp MINUS>;
            key-positions = <9 10>;
        };

        controlleft {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <12 13>;
        };

        controlright {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <29 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE  &mt LEFT_GUI LS(LANG2)  &mo 2  &mt LEFT_SHIFT SPACE  &kp RET  &mo 3  &mt RIGHT_ALT LANG1
            >;
        };

        win {
            display-name = "WIN";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE  &kp LALT  &mo 2  &mt LEFT_SHIFT SPACE  &kp RET  &mo 3  &kp LG(SPACE)
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans  &kp LSHFT  &studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &kp UP_ARROW  &trans  &trans  &trans  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC  &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&mo 0  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &to 0  &to 1  &kp F3  &trans  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo 2  &kp SPACE  &kp RET  &mo 3  &kp RALT
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
