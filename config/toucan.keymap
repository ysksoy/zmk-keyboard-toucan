#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_MAC  0
#define LAYER_WIN  1
#define LAYER_NAV  2
#define LAYER_SYM  3
#define LAYER_ADJ  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LAYER_NAV LAYER_SYM>;
            then-layer = <LAYER_ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rightclick {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        leftclick {
            bindings = <&mkp LCLK>;
            key-positions = <19 18>;
        };

        // Mac-specific combos

        returninbrows_mac {
            bindings = <&kp LG(LEFT_BRACKET)>;
            key-positions = <14 15>;
            layers = <LAYER_MAC>;
        };

        goahead_mac {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <17 16>;
            layers = <LAYER_MAC>;
        };

        screenshot_mac {
            bindings = <&kp LG(LS(LC(NUMBER_4)))>;
            key-positions = <0 1>;
            layers = <LAYER_MAC>;
        };

        reloadingbrows_mac {
            bindings = <&kp LG(R)>;
            key-positions = <15 16>;
            layers = <LAYER_MAC>;
        };

        controlcenter_mac {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <26 27>;
            layers = <LAYER_MAC>;
        };

        // Windows-specific combos

        returninbrows_win {
            bindings = <&kp K_BACK>;
            key-positions = <14 15>;
            layers = <LAYER_WIN>;
        };

        goahead_win {
            bindings = <&kp K_FORWARD>;
            key-positions = <17 16>;
            layers = <LAYER_WIN>;
        };

        screenshot_win {
            bindings = <&kp LG(LS(S))>;
            key-positions = <0 1>;
            layers = <LAYER_WIN>;
        };

        reloadingbrows_win {
            bindings = <&kp F5>;
            key-positions = <15 16>;
            layers = <LAYER_WIN>;
        };

        taskview_win {
            bindings = <&kp LG(TAB)>;
            key-positions = <26 27>;
            layers = <LAYER_WIN>;
        };

        // Common combos (work on both layers)

        minus {
            bindings = <&kp MINUS>;
            key-positions = <9 10>;
        };

        controlleft {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <12 13>;
            layers = <LAYER_MAC>;
        };

        controlright {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <29 28>;
            layers = <LAYER_MAC>;
        };

        controlleft_win {
            bindings = <&kp LG(LC(LEFT_ARROW))>;
            key-positions = <12 13>;
            layers = <LAYER_WIN>;
        };

        controlright_win {
            bindings = <&kp LG(LC(RIGHT_ARROW))>;
            key-positions = <29 28>;
            layers = <LAYER_WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp F13  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE  &mt LEFT_GUI LS(LANG2)  &mo LAYER_NAV  &mt LEFT_SHIFT SPACE  &kp RET  &mo LAYER_SYM  &mt RIGHT_ALT LANG1
            >;
        };

        win {
            display-name = "WIN";
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp F13  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE  &mt LCTRL LANG2  &mo LAYER_NAV  &mt LEFT_SHIFT SPACE  &kp RET  &mo LAYER_SYM  &mt RIGHT_ALT LANG1
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N1  &kp N2  &kp N3  &kp N0  &kp N0  &kp BSPC  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp N4  &kp N5  &kp NUMBER_6  &kp RIGHT  &trans  &trans  &kp LSHFT  &studio_unlock  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans  &kp RA(SPACE)  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC  &kp LCTRL  &trans  &trans  &kp UP_ARROW  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &kp LSHFT  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&mo LAYER_MAC  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &to LAYER_MAC  &to LAYER_WIN  &kp F3  &trans  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo LAYER_NAV  &kp SPACE  &kp RET  &mo LAYER_SYM  &kp RALT
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
